# =====================================================================
# Sugarcane Dept Chatbot — Backend Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env.
# =====================================================================

APP_NAME=Sugarcane Dept Chatbot
ENV=development
DEBUG=True

# ── Postgres ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/sugarcane_dept_chatbot

# ── Auth ──────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Gemini (LLM + embeddings) ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── Web search fallback (used in hybrid/web_only modes) ──────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── Qdrant (vector DB) ────────────────────────────────────────────────
QDRANT_URL=your_qdrant_url_here
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=sugarcane_documents

# ── Email (verification / password reset — admin accounts only) ─────
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=noreply@ganna-sahayak.example.com

# ── Google OAuth (admin sign-in, optional) ───────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── Frontend / CORS ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ── Admin bootstrap — leave empty to skip auto-creation, use
# scripts/create_admin.py instead ────────────────────────────────────
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# =====================================================================
# New in v2 — dual-mode RAG, escalation, cache, rate limiting
# =====================================================================

# Confidence thresholds (escalation sensitivity) — see UPGRADE_NOTES.md
CONFIDENCE_RETRIEVAL_LOW=0.55
CONFIDENCE_COMBINED_LOW=0.45
CONFIDENCE_LLM_LOW_LABELS=low,no_answer

# Semantic response cache
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=500

# Rate limiting
PUBLIC_CHAT_RATE_LIMIT=10/minute
ADMIN_RATE_LIMIT=60/minute

# Ad-hoc PDF max size (bytes) — admin chat-scoped PDF summarization
ADHOC_PDF_MAX_BYTES=20971520
