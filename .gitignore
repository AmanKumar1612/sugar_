# ========================
# Python / Backend
# ========================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
ENV/
env/
.env.bak

# Environment variables (secrets)
backend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.production.local
# Keep examples
!backend/.env.example
!frontend/.env.example

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# mypy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# Alembic
# (keep migrations, ignore local DB artifacts)

# Uploads / generated data
backend/uploads/
backend/data/pdfs/*.pdf
!backend/data/pdfs/sample.pdf

# ========================
# Node.js / Frontend
# ========================
node_modules/
frontend/.next/
frontend/out/
frontend/.cache/
frontend/build/
frontend/dist/

# npm / yarn / pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
# Uncomment if using yarn:
# yarn.lock

# ========================
# Docker
# ========================
*.dockerignore
docker-compose.override.yml

# ========================
